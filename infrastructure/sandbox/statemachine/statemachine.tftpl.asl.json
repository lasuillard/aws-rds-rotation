{
    "Comment": "aws-rds-rotation",
    "StartAt": "Prepare",
    "States": {
        "Prepare": {
            "Type": "Wait",
            "Seconds": 5,
            "Next": "Find old database",
            "Assign": {
                "inputs": "{% (\n  $dbIdPrefix := \"${db_id_prefix}\";\n  {\n    \"dbIdPrefix\": $dbIdPrefix,\n    \"newDbIdRaw\": $states.input.newDbId,\n    \"newDbId\": $exists($states.input.newDbId) ? $states.input.newDbId : $dbIdPrefix & $now(\"[Y0001][M01][D01]t[H01][m01][s01]\", \"+0900\"),\n    \"snapshotId\": $states.input.snapshotId,\n    \"lambdaFunctionName\": \"${lambda_function_name}\",\n    \"route53HostedZoneId\": \"${route53_hosted_zone_id}\",\n    \"route53DomainName\": \"${route53_domain_name}\"\n  }\n)\n %}"
            }
        },
        "Find old database": {
            "Type": "Task",
            "Arguments": {},
            "Resource": "arn:aws:states:::aws-sdk:rds:describeDBInstances",
            "Next": "Check instance count",
            "Assign": {
                "matchedInstances": "{% $states.result.DbInstances[$substring(DbInstanceIdentifier, 0, $length($inputs.dbIdPrefix)) = $inputs.dbIdPrefix] %}"
            }
        },
        "Check instance count": {
            "Type": "Choice",
            "Choices": [
                {
                    "Next": "Too many instances (>1)",
                    "Condition": "{% (($count($matchedInstances)) > (1) and $not($exists($inputs.newDbIdRaw))) %}"
                }
            ],
            "Default": "Restore DB instance from snapshot",
            "Assign": {
                "oldDb": "{% $exists($matchedInstances[0]) ? $matchedInstances[0] : null %}",
                "oldDbId": "{% $exists($matchedInstances[0]) ? $matchedInstances[0].DbInstanceIdentifier : null %}"
            }
        },
        "Too many instances (>1)": {
            "Type": "Fail",
            "Error": "TooManyInstances",
            "Cause": "{% \"There are more than 1 instances (\" & $count($matchedInstances) & \") found. Which might indicate that another workflow in in progress. Retry later.\" %}",
            "Comment": "If there are more than 1 instances, it could be a sign of that another workflow is in progress. If you meant to continue the ongoing workflow from failure, set input newDbId to the identifier of created instance."
        },
        "Restore DB instance from snapshot": {
            "Type": "Task",
            "Arguments": {
                "DbInstanceIdentifier": "{% $inputs.newDbId %}",
                "DbSnapshotIdentifier": "{% $inputs.snapshotId %}",
                "DbSubnetGroupName": "{% $oldDb.DbSubnetGroup.DbSubnetGroupName %}",
                "PubliclyAccessible": "{% $oldDb.PubliclyAccessible %}",
                "VpcSecurityGroupIds": "{% $oldDb.VpcSecurityGroups[].VpcSecurityGroupId %}",
                "Tags": [
                    {
                        "Key": "Project",
                        "Value": "aws-rds-rotation"
                    }
                ]
            },
            "Resource": "arn:aws:states:::aws-sdk:rds:restoreDBInstanceFromDBSnapshot",
            "Next": "Wait for DB instance ready",
            "Catch": [
                {
                    "ErrorEquals": [
                        "Rds.DbInstanceAlreadyExistsException"
                    ],
                    "Next": "Check DB instance status",
                    "Comment": "Skip if instance already exists"
                }
            ]
        },
        "Wait for DB instance ready": {
            "Type": "Wait",
            "Seconds": 30,
            "Next": "Check DB instance status"
        },
        "Check DB instance status": {
            "Type": "Task",
            "Arguments": {
                "DbInstanceIdentifier": "{% $inputs.newDbId %}"
            },
            "Resource": "arn:aws:states:::aws-sdk:rds:describeDBInstances",
            "Assign": {
                "dbStatus": "{% $states.result.DbInstances[0].DbInstanceStatus %}",
                "dbDomain": "{% $states.result.DbInstances[0].Endpoint ? $states.result.DbInstances[0].Endpoint.Address : 'n/a' %}"
            },
            "Next": "Is DB instance available?"
        },
        "Is DB instance available?": {
            "Type": "Choice",
            "Choices": [
                {
                    "Condition": "{% ($dbStatus) = (\"available\") %}",
                    "Next": "Run SQL queries"
                },
                {
                    "Next": "Wait for DB instance ready",
                    "Condition": "{% $dbStatus in [\"creating\", \"starting\", \"storage-initialization\", \"configuring-enhanced-monitoring\", \"modifying\"] %}"
                }
            ],
            "Default": "Instance restoration failed"
        },
        "Instance restoration failed": {
            "Type": "Fail",
            "Error": "InstanceRestorationFailed",
            "Cause": "Failed to restore database instance from snapshot.",
            "Comment": "Instance restoration entered unexpected status. Please diagnose the RDS events."
        },
        "Run SQL queries": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Output": "{% $states.result.Payload %}",
            "Arguments": {
                "Payload": "{% $states.input %}",
                "FunctionName": "{% $inputs.lambdaFunctionName %}"
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                }
            ],
            "Next": "Update domain record to new database"
        },
        "Update domain record to new database": {
            "Type": "Task",
            "Arguments": {
                "ChangeBatch": {
                    "Changes": [
                        {
                            "Action": "UPSERT",
                            "ResourceRecordSet": {
                                "Name": "{% $inputs.route53DomainName %}",
                                "Type": "CNAME",
                                "Ttl": 60,
                                "ResourceRecords": [
                                    {
                                        "Value": "{% $dbDomain %}"
                                    }
                                ]
                            }
                        }
                    ]
                },
                "HostedZoneId": "{% $inputs.route53HostedZoneId %}"
            },
            "Resource": "arn:aws:states:::aws-sdk:route53:changeResourceRecordSets",
            "Next": "Old instance exists?"
        },
        "Old instance exists?": {
            "Type": "Choice",
            "Choices": [
                {
                    "Next": "Delete old database",
                    "Condition": "{% $oldDbId != null %}"
                }
            ],
            "Default": "No instance to delete"
        },
        "Delete old database": {
            "Type": "Task",
            "Arguments": {
                "DbInstanceIdentifier": "{% $oldDbId %}",
                "SkipFinalSnapshot": true
            },
            "Resource": "arn:aws:states:::aws-sdk:rds:deleteDBInstance",
            "End": true
        },
        "No instance to delete": {
            "Type": "Pass",
            "End": true
        }
    },
    "QueryLanguage": "JSONata"
}
